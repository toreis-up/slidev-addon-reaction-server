{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slidev-addon-reaction-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-16",
  "durable_objects": {
    "bindings": [
      {
        "name": "REACTION_ROOM",
        "class_name": "ReactionRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ReactionRoom"
      ]
    }
  ],
  "assets": {
    "binding": "ASSET",
    "directory": "ui/.output/public",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/rooms/*",
      "/api/rooms"
    ]
  },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "r.reisan.dev"
    }
  ]
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
